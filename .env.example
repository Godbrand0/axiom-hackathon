# Copy to .env and fill in. Never commit .env.

# --- Required: Alpaca market data (free "Basic" plan, https://alpaca.markets) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "sip" = consolidated US tape. The free plan allows SIP history that is >15 min old,
# which is all a daily after-close scan needs. Use "iex" if your account rejects sip.
ALPACA_DATA_FEED=sip

# --- Required: SEC EDGAR asks every client to identify itself ---
# Format: "<app name> <contact email>"
SEC_USER_AGENT=

# --- Optional: free LLM writes the bull/bear narrative. Leave AXIOM_LLM_MODEL empty for numbers-only reports. ---
# Any OpenAI-compatible endpoint works. Pick ONE block (check each provider's current model list).

# Option A: Ollama, local, free, private. Install from ollama.com, then: ollama pull qwen3:8b
AXIOM_LLM_BASE_URL=http://localhost:11434/v1
AXIOM_LLM_API_KEY=
AXIOM_LLM_MODEL=qwen3:8b

# Option B: Groq free tier (console.groq.com), fast, larger models
# AXIOM_LLM_BASE_URL=https://api.groq.com/openai/v1
# AXIOM_LLM_API_KEY=
# AXIOM_LLM_MODEL=llama-3.3-70b-versatile

# Option C: Google Gemini free tier (aistudio.google.com)
# AXIOM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AXIOM_LLM_API_KEY=
# AXIOM_LLM_MODEL=gemini-2.5-flash

# --- Optional: Telegram alerts (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional ---
AXIOM_DB=axiom.db
AXIOM_REPORTS_DIR=reports
